rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The app reads/writes Firestore exclusively through the Admin SDK,
    // which bypasses these rules. No Firebase client SDK is used, so there
    // is no legitimate client-side access path: deny everything.
    //
    // Rationale (security audit 2026-06): the public Firebase API key lets
    // anyone mint an authenticated token via self-signup, so any rule keyed
    // on `request.auth != null` is reachable by arbitrary internet users.
    // The previous /users/** and ref_* grants served no client and only
    // widened the attack surface.
    //
    // Phase I (MCP): the OAuth collections (oauth_clients, oauth_codes,
    // oauth_tokens) hold credential hashes and are likewise Admin-SDK-only —
    // they are intentionally covered by this same deny-all.
    //
    // Phase N (chat): chat_conversations (+turns), chat_drafts/chat_skills
    // (+versions), chat_scheduled_tasks and chat_usage_dossier hold
    // privileged legal work product and are Admin-SDK-only too — same
    // deny-all. The registre's compensating control is the project-level
    // Firestore Data Access audit logging (DEPLOYMENT.md §11b step 1),
    // not a rule here.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
