# Versions are exact-pinned (==X.Y.Z) so OSV-Scanner can resolve a single
# concrete version per line. Wildcards (==X.*) prevented the scanner from
# matching the actual installed version and produced false-positive CVE
# reports across the major series. Dependabot's weekly minor/patch group
# (see .github/dependabot.yml) keeps these moving.
Flask==3.1.3
firebase-admin==7.4.0
flask-wtf==1.3.0
flask-limiter==4.1.1
gunicorn==25.3.0
google-cloud-firestore==2.27.0
google-cloud-storage==3.10.1
google-cloud-secret-manager==2.27.0
google-cloud-logging==3.15.0
# Portail client (spec L1): the portal enqueues events onto the « portail »
# Cloud Tasks queue; the main service's handler consumes them. Reused as-is
# by the future phase J notification pipeline.
google-cloud-tasks==2.23.0
# requests was already in the hash lock as a locked transitive (cachecontrol,
# google-api-core, ...). utils/graph.py (Microsoft Graph outbound email) now
# imports it directly, so it is promoted to a direct pin — Dependabot and
# OSV-Scanner track direct deps only.
requests==2.33.1
# OpenTelemetry — distributed tracing → Cloud Trace via the OTLP endpoint.
# Versions are PAIRED and must move together: the stable line (api/sdk 1.44.0)
# ships alongside the beta contrib line (instrumentation 0.65b0), and each
# instrumentation package hard-pins its siblings at `==0.65b0`. Bumping one
# alone is unresolvable — this is a single atomic edit, and Dependabot cannot
# automate it (majors are not grouped; each per-package PR would conflict).
opentelemetry-api==1.44.0
opentelemetry-sdk==1.44.0
# Export goes to telemetry.googleapis.com over OTLP/gRPC (2026-07-30, replacing
# the deprecated opentelemetry-exporter-gcp-trace). gRPC and not HTTP because
# only the gRPC exporter takes `credentials=`, which is the ONLY auth path that
# refreshes the token per RPC — `headers=` is frozen at construction, so a
# Bearer token there would expire in ~1 h and UNAUTHENTICATED is not a
# retryable code: traces would stop while the app kept serving. grpcio is
# already required by ten other packages (Firestore, Logging, Secret Manager,
# Cloud Tasks…), so this adds no native weight.
opentelemetry-exporter-otlp-proto-grpc==1.44.0
# Three upstream-maintained lines producing exactly MIGRATION.md's
# composite_channel_credentials(ssl, metadata_call_credentials(AuthMetadataPlugin))
# pattern. Beta, but trivially inlinable into tracing_setup.py if it ever
# stalls. All of its deps (grpcio, google-auth, requests) are already locked.
opentelemetry-exporter-credential-provider-gcp==0.65b0
# NOT deprecated and NOT part of the exporter family — this is the
# X-Cloud-Trace-Context propagator, which the OTLP migration leaves untouched.
opentelemetry-propagator-gcp==1.12.0
opentelemetry-instrumentation-flask==0.65b0
opentelemetry-instrumentation-requests==0.65b0
opentelemetry-instrumentation-jinja2==0.65b0
# Was transitive via the (now removed) GCP exporter; kept as a direct pin
# because it supplies the GCP resource labels, and because the version
# immediately below is a trap: 1.13.0 is YANKED upstream ("breaks imports" —
# the package moved from opentelemetry-operations-python to
# opentelemetry-python-contrib with a wrong namespace; 1.14.0 restored it).
# An import failure here is swallowed by tracing_setup's `except Exception`,
# so landing on 1.13.0 would disable trace export SILENTLY.
# NB: it does NOT provide `gcp.project_id` — only `cloud.account.id`. The
# routing attribute is set by hand in _build_resource(); MIGRATION.md's claim
# to the contrary is wrong.
opentelemetry-resourcedetector-gcp==1.14.0
icalendar==7.0.3
vobject==0.9.9
bcrypt==5.0.0
python-dotenv==1.2.2
reportlab==4.4.10
# Pillow is a transitive dependency of reportlab (which only requires >=9.0.0).
# Pinned explicitly here for CVE hygiene. 12.3.0 clears a batch of 2026
# image-decoder advisories (CVE-2026-54059 / 54060 / 55379 / 55380 / 55798 /
# 59199 / 59203 / 59205) on top of the earlier CVE-2023-44271 (Pillow <10),
# CVE-2026-25990 (PSD OOB write) and CVE-2026-40192 (FITS GZIP decompression
# bomb). None are reachable here — reportlab emits tabular PDFs and no
# untrusted image is ever decoded (no `import PIL` anywhere) — so this is a
# hygiene bump.
Pillow==12.3.0
Markdown==3.10.2
# bleach is archived upstream; 6.4.0 is a security release clearing the
# URI-scheme sanitization advisories (GHSA-gj48-438w-jh9v, GHSA-8rfp-98v4-mmr6)
# and moving off the 6.3.0-only linkify email-DoS advisory (GHSA-g75f-g53v-794x).
# Longer term, migrate note sanitization to nh3 (maintained successor) to exit
# this recurring class of unpatched bleach alerts.
bleach==6.4.0
defusedxml==0.7.1
# Transitive deps pinned explicitly for CVE hygiene (same rationale as Pillow):
# all arrive via the google/firebase client stack. cryptography 50.0.0 clears
# the 2026-08 batch — CVE-2026-69247 (PKCS#7 EnvelopedData Bleichenbacher
# oracle, fixed 50.0.0), CVE-2026-69249 (exponential X.509 path-building) and
# CVE-2026-69248 (wildcard-SAN escape from permittedSubtrees), both fixed
# 49.0.0 — on top of the earlier bundled-OpenSSL patch (GHSA-537c-gmf6-5ccf).
# None was reachable here (the app never decrypts PKCS#7 nor builds X.509
# chains with cryptography's verifier — it only verifies Firebase JWT
# signatures), so these are hygiene bumps. msgpack 1.2.1 fixes an Unpacker
# out-of-bounds read after a caught error (GHSA-6v7p-g79w-8964). h2 4.4.1
# fixes CVE-2026-71554 (duplicate Host header forwarded on HTTP/2→1.1
# downgrade — a request-smuggling primitive for SERVERS; here h2 is only
# httpx's outbound HTTP/2 client via firebase-admin, so equally unreachable).
cryptography==50.0.0
msgpack==1.2.1
h2==4.4.1
# PDF text extraction, added 2026-08-26 for the MCP get_document_text tool
# (the stdlib cannot read a PDF). Pure Python — no native libs, so App Engine
# Standard safe. Sole consumer: utils/pdf_text.py, which
# caps input at models/document.DOCUMENT_TEXT_MAX_BYTES BEFORE any byte is
# downloaded (pypdf's parse memory runs ~2-3x file size) and isolates each
# page's extract_text() so one malformed page never kills the call.
pypdf==6.16.2
# NOTE: the `setuptools<81` constraint that used to live here is GONE, and
# with it setuptools itself — `opentelemetry-instrumentation` dropped its
# pkg_resources dependency at 0.49b0, so nothing pulls setuptools into the
# graph any more. That is what closes CVE-2026-59890 (PYSEC-2026-3447 /
# GHSA-h35f-9h28-mq5c) on all three scanning surfaces at once, rather than
# suppressing it on each. Do not reintroduce a setuptools pin without
# re-reading why it existed.
