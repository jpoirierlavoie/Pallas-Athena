# Pallas Athena — local development environment template.
# Copy to .env (gitignored) and fill in real values. Production does NOT use
# this file: sensitive values come from Google Cloud Secret Manager
# (see athena/config.py) and identifiers from athena/app.yaml + portail.yaml.
#
# ADOPTERS: every value below is a PLACEHOLDER. Until 2026-09-12 the project
# id and bucket here were the ORIGINAL deployment's live values, "kept as a
# format example" — which is how a fresh clone ends up pointed at somebody
# else's Firestore, and those exact strings are what the fork-hygiene scan
# hunts for. Fill in your own, then verify with:
#     cd athena && python -m scripts.check_config
#
# The authority for what each name does is DEPLOYMENT.md §4.1, which is
# complete by derivation (a test fails if the configuration reads a name the
# document does not list). This file mirrors it for the values a local
# developer actually sets.

# ── Core ────────────────────────────────────────────────────────────────
ENV=development

# Flask session signing key — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Firebase / GCP identifiers (non-secret)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_APP_ID=
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
# Public-by-design web API key (still kept out of git)
FIREBASE_API_KEY=

# Single authorized user
AUTHORIZED_USER_EMAIL=

# Session
SESSION_LIFETIME_HOURS=12

# DAV Basic Auth — bcrypt hash of the DAV password. DEPLOYMENT.md §6.4 has the
# recipe that measures the hash before writing it; 61 bytes never matches the
# 60 bcrypt recomputes, and DavX5 then stops syncing without a word.
#   python -c "import bcrypt, getpass; print(bcrypt.hashpw(getpass.getpass().encode(), bcrypt.gensalt()).decode())"
DAV_PASSWORD_HASH=

# App Check (reCAPTCHA Enterprise); APPCHECK_DEBUG_TOKEN is local-dev only
RECAPTCHA_ENTERPRISE_SITE_KEY=
APPCHECK_DEBUG_TOKEN=

# Multi-factor authentication enforcement (server-side gate). Set false
# locally unless you have enrolled Phone MFA on your dev user.
REQUIRE_MFA=true

# Rate limiting
RATE_LIMIT_LOGIN=5 per minute

# Observability — trace sampling ratio (read by utils/tracing_setup.py).
# 0.1 = 10% of requests sampled in production; raise toward 1.0 locally to see
# every trace, lower it to reduce volume/cost.
TRACE_SAMPLE_RATIO=0.1

# Cloudflare origin secret (optional): when set, every request must carry the
# same value in X-Origin-Auth (injected by a Cloudflare Transform Rule).
# Leave EMPTY in local dev — a value here makes every local request 403.
CF_ORIGIN_SECRET=

# ── MCP connector ───────────────────────────────────────────────────────
# MCP_ENABLED=false is the kill switch (all /mcp + /oauth/* routes 404).
# MCP_WRITE_ENABLED=false removes the 22 write tools from tools/list, refuses
# them at tools/call, and hides the consent checkbox; reads are untouched.
# MCP_CANONICAL_ORIGIN is the OAuth issuer — override for local MCP Inspector
# testing, e.g. http://localhost:8080
MCP_ENABLED=true
MCP_WRITE_ENABLED=true
MCP_CANONICAL_ORIGIN=http://localhost:8080

# ── Firm profile — SEED AND FALLBACK ONLY ───────────────────────────────
# The live profile is edited in the application (Paramètres) and stored in
# Firestore at settings/cabinet. These bootstrap a fresh deploy on an empty
# database and are what the app falls back to if Firestore is unreadable.
# FIRM_PROVINCE accepts either "QC" or "Québec" — the two-letter form is
# migrated to the full name on the first save, matching every contact address
# in the app. GST/QST are snapshotted PER INVOICE at creation, so changing
# them here affects future invoices only.
FIRM_NAME=
FIRM_STREET=
FIRM_UNIT=
FIRM_CITY=
FIRM_PROVINCE=Québec
FIRM_POSTAL_CODE=
FIRM_PHONE=
FIRM_FAX=
FIRM_EMAIL=
GST_NUMBER=
QST_NUMBER=

# ── Microsoft Graph — outbound email ────────────────────────────────────
# All four non-secret values must be set for outbound email to run at all
# (Config.graph_configured()). GRAPH_CLIENT_SECRET is Secret-Manager-backed in
# production and is read with required=False, which swallows a
# PERMISSION_DENIED into "" — a missing accessor binding turns invitations,
# accusés and intake confirmations off SILENTLY.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_SENDER_UPN=
GRAPH_SENDER_NAME=
GRAPH_CLIENT_SECRET=

# ── Bookings sync (L2) ──────────────────────────────────────────────────
# BOOKINGS_JURISTE_UPN empty short-circuits the sync. BOOKINGS_SUBJECT_KEYWORDS
# is comma-separated and a subject matches when it ENDS with
# « {separator} {keyword} » — an EMPTY value is a total, silent outage, so the
# sync refuses to run rather than flag every prior import as cancelled.
BOOKINGS_JURISTE_UPN=
BOOKINGS_SYNC_ACTIVE=true
BOOKINGS_SUBJECT_KEYWORDS=Consultation
BOOKINGS_SYNC_LOOKAHEAD_DAYS=90
BOOKINGS_SYNC_LOOKBACK_DAYS=1
# Predicate tuning: logs the first detected and first undetected event AT INFO
# (domains and booleans only — never the subject, which embeds a client name).
BOOKINGS_DEBUG_PAYLOAD=false

# ── Outlook mirror ──────────────────────────────────────────────────────
# false freezes existing mirrors in place; it does not clean them up. The two
# windows are SHARED by the Athéna read and the Outlook read — that is what
# keeps a mirrored event from becoming an invisible orphan.
MIROIR_OUTLOOK_ACTIF=true
MIROIR_OUTLOOK_LOOKAHEAD_DAYS=365
MIROIR_OUTLOOK_LOOKBACK_DAYS=30

# ── Portail client ──────────────────────────────────────────────────────
# Read by the SECOND App Engine service, which runs in its own process under
# its own service account and never imports athena/config.py.
# FEATURE_INTAKE offers the dossier-opening form when confirming a Bookings
# rendez-vous whose email matches no contact.
# TASKS_LOCATION must equal your App Engine region (gcloud app describe): it
# is NOT derived, and a mismatch makes every signaler() raise NOT_FOUND at
# finalization — a failure the portal swallows by design.
FEATURE_INTAKE=false
PORTAIL_SECRET_KEY=
PORTAIL_HOST=portail.your-domain.example
PORTAIL_BUCKET=
TASKS_LOCATION=northamerica-northeast1
